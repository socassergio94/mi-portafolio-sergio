---
const { name, level = 60 } = Astro.props;
const pct = Math.max(0, Math.min(100, level));
---
<div class="skill-row">
  <div class="skill-label">{name}</div>
  <div class="skill-bar" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
    <div class="skill-fill" style={`width:${pct}%`}></div>
  </div>
</div>
