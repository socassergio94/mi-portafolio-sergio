---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contacto | Sergio Socas" description="Ponte en contacto con Sergio Socas.">
  <section class="container contact-section">
    <div class="contact-grid">
      <div class="contact-form card">
        <h2>Hablemos de tu proyecto</h2>
        <p class="muted">Rellena el formulario con los detalles y te responderé en menos de 48 horas.</p>
        <form id="contactForm" on:submit preventDefault>
          <label class="field">
            <span>Nombre</span>
            <input type="text" name="name" id="name" required placeholder="Tu nombre completo" />
          </label>
          <label class="field">
            <span>Email</span>
            <input type="email" name="email" id="email" required placeholder="tu@ejemplo.com" />
          </label>
          <label class="field">
            <span>Asunto</span>
            <input type="text" name="subject" id="subject" placeholder="Breve descripción del proyecto" />
          </label>
          <label class="field">
            <span>Mensaje</span>
            <textarea name="message" id="message" rows="6" placeholder="Cuéntame los objetivos, público y tecnologías..." required></textarea>
          </label>
          <div class="form-row">
            <button class="btn" type="submit">Enviar mensaje</button>
            <button class="btn btn-ghost" type="button" id="clearBtn">Limpiar</button>
          </div>
          <p id="formStatus" class="muted" aria-live="polite"></p>
        </form>
      </div>
      <div class="contact-info">
        <h3>Contacto directo</h3>
        <p>Email: <a href="mailto:socassergio94@gmail.com">socassergio94@gmail.com</a></p>
        <p>GitHub: <a href="https://github.com/socassergio94" target="_blank">github.com/socassergio94</a></p>
        <h4>Qué incluyo en la respuesta</h4>
        <ul>
          <li>Valoración inicial del alcance</li>
          <li>Tecnologías recomendadas</li>
          <li>Estimación de tiempo (alto nivel)</li>
        </ul>
      </div>
    </div>
    <script>
      const form = document.getElementById('contactForm');
      const status = document.getElementById('formStatus');
      const clearBtn = document.getElementById('clearBtn');
      form.addEventListener('submit', () => {
        // Simulated send — replace with Formspree / EmailJS if needed
        status.textContent = 'Enviando...';
        setTimeout(() => {
          status.textContent = '¡Mensaje enviado! Te responderé en menos de 48 horas.';
          form.reset();
        }, 900);
      });
      clearBtn.addEventListener('click', () => form.reset());
    </script>
  </section>
</BaseLayout>
